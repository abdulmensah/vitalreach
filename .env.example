# Copy this file to .env for localhost development.
# Environment variables already defined by the OS take precedence.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5201
ConnectionStrings__Catalog=Data Source=App_Data/vitalreach.db
DataProtection__Path=App_Data/keys
DataProtection__ApplicationName=VitalReach.Local
ProductImages__Path=App_Data/uploads/products

# Optional: required only for testing the authenticated admin portal locally.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# reCAPTCHA v3 score-based. Missing configuration blocks contact submissions.
# Register only the hostnames used by this environment, comma separated below.
Recaptcha__SiteKey=
Recaptcha__ScoreThreshold=0.5
Recaptcha__UseRecaptchaNet=false
Recaptcha__SecretKey=
Recaptcha__AllowedHosts=localhost,127.0.0.1
# Explicit local-only bypass; ignored outside ASPNETCORE_ENVIRONMENT=Development.
Recaptcha__DevelopmentBypass=false

# Commerce: set an HTTPS public URL matching the deployed storefront.
Commerce__PublicUrl=https://vitalreachhub.com
Commerce__SellerCountry=US
Commerce__SellerState=MD
# Enable only after the real seller address and tax registrations are configured in Stripe Tax.
# Maryland is the seller state, not a blanket tax rate for every delivery address.
Commerce__UsTaxConfigured=false
# Server-side secrets only; use test-mode keys until end-to-end provider checks pass.
Payments__Stripe__SecretKey=
Payments__Stripe__WebhookSecret=
Payments__Paystack__SecretKey=
# Webhooks: /payments/stripe/webhook and /payments/paystack/webhook
# Shipping, Ghana tax, and the USD-to-GHS rate are reviewed for each quote in /admin/orders.

# Consultation intake: enable after clinical rules, privacy/retention and reviewer access are approved.
Intake__Enabled=false
Intake__PublicUrl=https://vitalreachhub.com
# Reviewer permissions are managed by a superadmin at /admin/users.

# AI site-help assistant (OpenAI Responses API); opt in after configuring keys.
Chatbot__Enabled=false
Chatbot__ApiKey=
Chatbot__Model=gpt-5-nano
Chatbot__MaxOutputTokens=2048
Chatbot__ReasoningEffort=low
# Shared per-process hourly request ceiling. Also set project spend controls at the provider.
Chatbot__MaxRequestsPerHour=60
# Docker reverse proxy: optionally trust specific Caddy container IPs.
# ForwardedHeaders__KnownProxies__0=172.18.0.2
