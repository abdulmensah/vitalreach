@page "/admin"
@page "/admin/products"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Admin")]

<PageTitle>Product administration | VitalReach</PageTitle>
<header class="admin-header"><a class="logo" href="/"><img src="images/vitalreach-logo.png" alt="VitalReach Wellness Hub" /></a><nav><a class="active" href="/admin/products">Products</a><a href="/admin/users">Access</a></nav><div><span>@AdminEmail</span><a href="/auth/logout">Sign out</a></div></header>
<main class="admin-shell">
    <header class="admin-title"><div><p class="eyebrow">Secure administration</p><h1>Product catalog</h1><p>Manage the products shown on the VitalReach storefront.</p></div><button class="btn btn-gold" @onclick="NewProduct">Add product</button></header>
    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="admin-message">@Message</div>
    }
    <div class="admin-grid">
        <section class="admin-list"><h2>Products</h2>@foreach (var product in Products) {
            <button class="admin-product @(Editing?.Id == product.Id ? "selected" : "")" @onclick="() => Edit(product)"><span><b>@product.Name</b><small>@product.Category · @product.Price.ToString("C")</small></span><i class="@(product.IsPublished ? "published" : "draft")">@(product.IsPublished ? "Published" : "Hidden")</i></button>
        }
    </section>
    <section class="admin-editor">
        @if (Editing is null)
        {
            <div class="admin-placeholder"><h2>Select a product</h2><p>Choose an item from the catalog or add a new product.</p></div>
        }
        else
        {

            <EditForm Model="Editing" OnValidSubmit="Save">
                <DataAnnotationsValidator /><ValidationSummary />
                <div class="form-grid"><label class="wide">Product name<InputText @bind-Value="Editing.Name" /></label><label>Slug<InputText @bind-Value="Editing.Slug" /></label><label>Price<InputNumber @bind-Value="Editing.Price" /></label><label>Category<InputText @bind-Value="Editing.Category" /></label><label>Package detail<InputText @bind-Value="Editing.Detail" /></label><label class="wide">Benefit statement<InputTextArea @bind-Value="Editing.Benefit" /></label><label class="wide">Product image URL<InputText @bind-Value="Editing.ImageUrl" placeholder="https://… or /images/products/…" /></label>@if (!string.IsNullOrWhiteSpace(Editing.ImageUrl)) { <div class="admin-image-preview wide"><img src="@Editing.ImageUrl" alt="Product image preview for @Editing.Name" /></div> }<label>Badge text<InputText @bind-Value="Editing.Orb" /></label><label>Color theme<InputSelect @bind-Value="Editing.Theme"><option value="gold-product">Gold</option><option value="teal-product">Teal</option><option value="pearl-product">Pearl</option><option value="berry-product">Berry</option></InputSelect></label><label>Label line one<InputText @bind-Value="Editing.LabelOne" /></label><label>Label line two<InputText @bind-Value="Editing.LabelTwo" /></label><label>Sort order<InputNumber @bind-Value="Editing.SortOrder" /></label><label class="check"><InputCheckbox @bind-Value="Editing.IsPublished" /> Published</label></div>
                <div class="form-actions"><button class="btn btn-gold" type="submit">Save product</button>@if (Editing.Id != 0) {
                    <button class="danger-button" type="button" @onclick="Delete">Delete product</button>
                }
            </div>
        </EditForm>
    }
</section>
</div>
</main>

@code {}
