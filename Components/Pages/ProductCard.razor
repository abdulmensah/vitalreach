<article class="product @Product.Theme"><div class="product-art"><span class="halo">@Product.Orb</span><div class="bottle"><b>V</b><small>VITALREACH</small><i>@Product.LabelOne<br>@Product.LabelTwo</i><span>PREMIUM WELLNESS</span></div></div><p class="category">@Product.Category</p><h3>@Product.Name</h3><p class="benefit">@Product.Benefit</p><div class="price-row"><strong>@Product.Price.ToString("C", CultureInfo.GetCultureInfo("en-US"))</strong><span>@Product.Detail</span></div><button class="add-cart" @onclick="() => OnAdd.InvokeAsync(Product)">Add to bag <span>+</span></button></article>
@code { [Parameter, EditorRequired] public ProductEntity Product { get; set; } = default!; [Parameter] public EventCallback<ProductEntity> OnAdd { get; set; } }
