<article class="product @Product.Theme">
    <a href="/shop/@Product.Slug" aria-label="View @Product.Name">
        <div class="product-art">
            @if (!string.IsNullOrWhiteSpace(Product.ImageUrl))
            {
                <img class="product-image" src="@Product.ImageUrl" alt="@Product.Name" loading="lazy" />
            }
            else
            {

                <span class="halo">@Product.Orb</span>
                <div class="bottle">
                    <b>V</b>
                    <small>VITALREACH</small>
                    <i>@Product.LabelOne<br>@Product.LabelTwo</i>
                    <span>PREMIUM WELLNESS</span>
                </div>
            }
        </div>
    </a>
    <p class="category">@Product.Category</p>
    <h3>
        <a href="/shop/@Product.Slug">@Product.Name</a>
    </h3>
    <p class="benefit">@Product.Benefit</p>
    <div class="product-card-footer">
        <div class="price-row">
            <strong>@((OnAdd.HasDelegate ? SelectedVariant?.Price ?? Product.DisplayPrice : Product.DisplayPrice).ToString("C", CultureInfo.GetCultureInfo("en-US")))</strong>
            <span>@(OnAdd.HasDelegate ? SelectedVariant?.DisplayName : Product.Variants.Count > 1 ? $"From · {Product.Variants.Count} variants" : Product.Variants.FirstOrDefault()?.DisplayName)</span>
        </div>
        @if (OnAdd.HasDelegate)
        {
            @if (Product.Variants.Count > 1)
            {
                <label class="variant-picker">Choose variant for @Product.Name
                    <select @bind="SelectedVariantId">@foreach (var variant in Product.Variants) { <option value="@variant.Id">@variant.DisplayName @(!variant.CanOrder ? "— unavailable" : "")</option> }</select>
                </label>
            }
            <button class="add-cart" disabled="@(SelectedVariant?.CanOrder != true)" @onclick="Add">
                @(SelectedVariant?.CanOrder == true ? "Add to bag" : "Unavailable") <span>+</span>
            </button>
        }
        else
        {

            <a class="add-cart" href="/shop/@Product.Slug">
                View product <span>→</span>
            </a>
        }

    </div>
</article>
