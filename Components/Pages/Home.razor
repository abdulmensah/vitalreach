@page "/"
@rendermode InteractiveServer
<PageTitle>Wellness with purpose | VitalReach Wellness Hub</PageTitle>

<div class="announcement">Proudly Ghanaian-American <span>✦</span> Free US shipping over $75</div>
<header class="site-header" id="top">
    <a class="logo" href="/#top">
        <img src="images/vitalreach-logo_header.png" alt="VitalReach Wellness Hub" />
    </a>
    <nav class="desktop-nav">
        <a href="/shop">Shop</a>
        <a href="/#ghana">Ghana Mission</a>
        <a href="/health-guide">Health Guide</a>
        <a href="/wellness-center">Wellness Center</a>
        <a href="/contact">Contact</a>
    </nav>
    <div class="header-actions">
        <button class="menu-trigger @(MenuOpen ? "open" : "")" @onclick="ToggleMenu" aria-label="Toggle navigation" aria-expanded="@MenuOpen">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <button class="cart-trigger" @onclick="OpenCart">
            Bag <span>@CartCount</span>
        </button>
    </div>
</header>
@if (MenuOpen)
{
    <nav class="mobile-menu" aria-label="Mobile navigation">
        <p>Explore VitalReach</p>
        <a href="/shop" @onclick="CloseMenu">
            <span>01</span> Shop
        </a>
        <a href="/#ghana" @onclick="CloseMenu">
            <span>02</span> Ghana Mission
        </a>
        <a href="/health-guide" @onclick="CloseMenu">
            <span>03</span> Health Guide
        </a>
        <a href="/wellness-center" @onclick="CloseMenu">
            <span>04</span> Wellness Center
        </a>
        <a href="/contact" @onclick="CloseMenu">
            <span>05</span> Contact
        </a>
        <div>
            <small>Wellness with purpose</small>
            <b>Educating Ghana. Reaching the world.</b>
        </div>
    </nav>
}
<main>
    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">Wellness, rooted in purpose</p>
            <h1>
                Reach further.<br>
                <em>Live fully.</em>
            </h1>
            <p class="lead">Premium wellness essentials and trusted health education—created to support families everywhere, with a special commitment to kidney-health awareness in Ghana.</p>
            <div class="actions">
                <a class="btn btn-gold" href="/#shop">
                    Shop the collection <span>→</span>
                </a>
                <a class="underlink" href="/#about">Meet VitalReach ↗</a>
            </div>
            <div class="trust">
                <span>Plant-based options</span>
                <span>Quality focused</span>
                <span>Education led</span>
            </div>
        </div>
        <div class="hero-visual" role="img" aria-label="VitalReach health education professional">
            <div class="promise">
                <small>The VitalReach promise</small>
                <strong>Clear choices.<br>Purposeful wellness.</strong>
            </div>
        </div>
    </section>
    <section class="mission" id="ghana">
        <div class="mission-badge">
            <b>GH</b>
        </div>
        <div>
            <p class="eyebrow">Our commitment to Ghana</p>
            <span>Education that reaches home.</span>

            <h2>
                Improving kidney-health awareness <em>in Ghana.</em>
            </h2>
            <p>Kidney disease can develop quietly. VitalReach Wellness Hub provides clear, practical education to help Ghanaians understand prevention, early screening, blood pressure, diabetes, medication safety, hydration and the kidney numbers that matter.</p>
            <strong>Educating Ghana. Reaching the world.</strong>
        </div>
        <a class="btn btn-outline" href="/health-guide">Explore Kidney Health Ghana →</a>
    </section>
    <nav class="ticker" aria-label="VitalReach values">
        <a href="/#shop">Premium quality</a>
        <i aria-hidden="true">✦</i>
        <a href="/terms">Responsible wellness</a>
        <i aria-hidden="true">✦</i>
        <a href="/health-guide">Health education</a>
        <i aria-hidden="true">✦</i>
        <a href="/#ghana">Global vision</a>
    </nav>
    <section class="section shop" id="shop">
        <header class="section-heading">
            <div>
                <p class="eyebrow">Shop VitalReach</p>
                <h2>
                    Daily wellness,<br>
                    <em>elevated.</em>
                </h2>
            </div>
            <p>Thoughtfully selected formulas designed to fit your everyday routine. Build your bundle and begin your wellness journey.</p>
        </header>
        <div class="featured-carousel" data-product-carousel>
            <div class="products" data-carousel-track aria-label="Featured products">
                @foreach (var product in Products)
                {
                    <ProductCard Product="product" OnAdd="AddToCart" />
                }
            </div>
            <div class="featured-carousel-controls" aria-label="Featured product carousel controls">
                <button type="button" data-carousel-prev aria-label="View previous featured product">←</button>
                <div class="featured-carousel-progress">
                    <span data-carousel-status aria-live="polite">1 / @Products.Count</span>
                    <div class="featured-carousel-dots" aria-label="Choose a featured product">
                        @for (var index = 0; index < Products.Count; index++)
                        {
                            <button type="button" class="@(index == 0 ? "active" : "")" data-carousel-index="@index" aria-label="View featured product @(index + 1)" aria-current="@(index == 0 ? "true" : null)"></button>
                        }
                    </div>
                </div>
                <button type="button" data-carousel-next aria-label="View next featured product">→</button>
            </div>
        </div>
        <p class="disclaimer">Product descriptions are for general information. Final labels and claims remain subject to formulation, testing, and regulatory review.</p>
        <a class="shop-all-link" href="/shop">Shop all products →</a>
    </section>
    @if (Headquarters is not null)
    {
        <section class="center-callout">
            <div>
                <p class="eyebrow light">Now at VitalReach headquarters</p>
                <h2>
                    Discover our Shopping &amp;<br />
                    <em>Wellness Center.</em>
                </h2>
                <p>Explore products, practical wellness support, and health education at @Headquarters.AddressLine1 in @Headquarters.City, @Headquarters.Country.</p>
            </div>
            <a class="btn btn-gold" href="/wellness-center">Learn more &amp; plan your visit →</a>
        </section>
    }
    <section class="story" id="about">
        <div class="story-art">
            <div class="story-constellation">
                <span class="story-orbit orbit-one" aria-hidden="true"></span>
                <span class="story-orbit orbit-two" aria-hidden="true"></span>
                <div class="story-logo-card">
                    <img src="/images/vitalreach-logo_homepage.png" alt="VitalReach Wellness Hub" />
                    <small>Reach your best. Live your best.</small>
                </div>
                <div class="story-value story-value-care">
                    <span aria-hidden="true">✦</span>
                    <b>Nurse-founded</b>
                    <small>Care with purpose</small>
                </div>
                <div class="story-value story-value-roots">
                    <span aria-hidden="true">◆</span>
                    <b>Ghanaian-American</b>
                    <small>Rooted locally.</small><small> Reaching globally.</small>
                </div>
                <div class="story-value story-value-wellness">
                    <span aria-hidden="true">●</span>
                    <b>Whole-person wellness</b>
                    <small>Education, products</small><small> &amp; support</small>
                </div>
            </div>
            <div class="seal">
                FOUNDED WITH<br>
                <b>CARE &amp; PURPOSE</b>
            </div>
        </div>
        <div class="story-copy">
            <p class="eyebrow light">Our story</p>
            <h2>
                Wellness that<br>
                <em>reaches home.</em>
            </h2>
            <p>VitalReach Wellness Hub was founded by Masaouda N. Nartey, BSN, RN, with a vision to make health education clearer, wellness choices more thoughtful, and quality products more accessible.</p>
            <p>Rooted in nursing experience and proudly Ghanaian-American, VitalReach brings together practical education, culturally connected care, and a global standard of excellence.</p>
            <div class="founder">
                <span>MN</span>
                <div>
                    <b>Masaouda N. Nartey, BSN, RN</b>
                    <small>Founder &amp; CEO</small>
                </div>
            </div>
        </div>
    </section>
    <span id="kidney-reading" class="anchor-target" aria-hidden="true"></span>
    <section class="health-preview" id="journal">
        <div class="health-preview-visual" role="img" aria-label="VitalReach kidney-health education and community wellness"></div>
        <div class="health-preview-copy">
            <p class="eyebrow">VitalReach Health Guide</p>
            <h2>Knowledge is part<br />of your <em>wellness.</em></h2>
            <p>Kidney disease can develop quietly. Learn the risk factors, understand the two tests that matter, and prepare better questions for your healthcare professional.</p>
            <div class="health-preview-topics">
                <span>Risk factors</span>
                <span>eGFR &amp; uACR</span>
                <span>Daily protection</span>
                <span>Medicine safety</span>
            </div>
            <a class="btn btn-gold" href="/health-guide">Explore the complete guide →</a>
            <small>Educational information—not medical advice, diagnosis, or treatment.</small>
        </div>
    </section>
    <section class="contact" id="contact">
        <div>
            <p class="eyebrow light">Begin your VitalReach journey</p>
            <h2>
                Wellness feels better<br>when it feels <em>personal.</em>
            </h2>
        </div>
        <div>
            <p>Questions about our collection, partnerships or upcoming availability? We would love to hear from you.</p>
            @*             @if (Headquarters is not null)
            {
                <address>
                    <small>Headquarters</small>@Headquarters.AddressLine1, @(Headquarters.AddressLine2 ?? "")<br />@Headquarters.CityRegion, @Headquarters.Country
                </address>
                <a class="phone" href="@Headquarters.PhoneHref">
                    <small>Call us</small>@Headquarters.Phone
                </a>
            <a class="btn btn-gold" href="/wellness-center">Learn more &amp; plan your visit →</a>

            }
 *@
            <a class="btn btn-gold" href="/contact?message=Hello%20VitalReach%2C%0A%0AI%20would%20like%20to%20get%20in%20touch%20with%20your%20team.%0A%0AThank%20you.#contact-content">Start a Converstation ↗</a>
        </div>
    </section>
</main>
<StorefrontFooter Headquarters="Headquarters" />

@if (CartOpen)
{
    <div class="cart-backdrop" @onclick="CloseCart">
    </div>
}
<aside class="cart @(CartOpen ? "open" : "")" aria-hidden="@(!CartOpen)">
    <header>
        <div>
            <small>Your selection</small>
            <h2>Shopping bag</h2>
        </div>
        <button class="cart-close" @onclick="CloseCart">×</button>
    </header>
    @if (Cart.Count == 0)
    {
        <div class="cart-empty">
            <span>V</span>
            <h3>Your bag is waiting.</h3>
            <p>Add a few wellness essentials to begin.</p>
            <button class="btn btn-outline" @onclick="CloseCart">Explore products</button>
        </div>
    }
    else
    {

        <div class="cart-items">
            @foreach (var line in Cart.Values)
            {
                <article class="cart-item">
                    <div>
                        <h3>@line.Product.Name</h3>
                        <p>@Money(line.Product.Price)</p>
                        <div class="quantity">
                            <button @onclick="() => ChangeQuantity(line.Product.Slug, -1)">−</button>
                            <span>@line.Quantity</span>
                            <button @onclick="() => ChangeQuantity(line.Product.Slug, 1)">+</button>
                        </div>
                    </div>
                    <button class="remove" @onclick="() => Remove(line.Product.Slug)">Remove</button>
                </article>
            }
        </div>
        <div class="cart-summary">
            <div>
                <span>Subtotal</span>
                <strong>@Money(Subtotal)</strong>
            </div>
            <p>Shipping and taxes calculated at checkout.</p>
            <button class="checkout" @onclick="BeginCheckout">Continue to checkout →</button>
        </div>
    }
</aside>
@if (CheckoutOpen)
{
    <div class="modal-backdrop" @onclick="CloseCheckout">
        <section class="checkout-dialog" @onclick:stopPropagation>
            <button class="dialog-close" @onclick="CloseCheckout">×</button>
            <p class="eyebrow">Secure checkout</p>
            <h2>You're almost there.</h2>
            <p>Online payment is being connected. Send your prepared order to our team and we’ll confirm availability, shipping, and a secure payment link.</p>
            <a class="btn btn-gold" href="@OrderContactUrl">Contact us about my order →</a>
        </section>
    </div>
}
