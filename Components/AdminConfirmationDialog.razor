<dialog id="admin-confirm-dialog" class="admin-confirm-dialog" aria-labelledby="admin-confirm-title" aria-describedby="admin-confirm-message">
    <form method="dialog">
        <p class="eyebrow">Confirm admin action</p>
        <h2 id="admin-confirm-title">Continue with this change?</h2>
        <p id="admin-confirm-message"></p>
        <p>Cancel leaves everything unchanged.</p>
        <div class="admin-confirm-actions">
            <button class="btn btn-outline" type="submit" value="cancel" autofocus>Cancel</button>
            <button class="btn btn-gold" type="submit" value="confirm">Confirm change</button>
        </div>
    </form>
</dialog>
