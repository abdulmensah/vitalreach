# Copy to /opt/hosting/apps/vitalreach-prod/.env, chmod 600; never commit secrets.
APP_IMAGE=ghcr.io/OWNER/REPOSITORY@sha256:REPLACE_WITH_WORKFLOW_DIGEST
# Docker IP of Caddy on hosting-edge, not the public VPS IP.
# The restricted deployment command overrides APP_IMAGE and CADDY_PROXY_IP.
# Manual Compose only: VITALREACH_DATA_PATH defaults to ./data. The command
# pins it to /var/lib/vitalreach-container/data.
CADDY_PROXY_IP=REPLACE_WITH_CADDY_CONTAINER_IP
APP_MEMORY=512m
APP_CPUS=0.75
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Recaptcha__SiteKey=
Recaptcha__SecretKey=
Recaptcha__AllowedHosts=vitalreachhub.com,www.vitalreachhub.com
Recaptcha__DevelopmentBypass=false
Commerce__PublicUrl=https://vitalreachhub.com
Commerce__SellerCountry=US
Commerce__SellerState=MD
Commerce__UsTaxConfigured=false
Payments__Stripe__SecretKey=
Payments__Stripe__WebhookSecret=
Payments__Paystack__SecretKey=
Intake__Enabled=false
Intake__PublicUrl=https://vitalreachhub.com
Chatbot__Enabled=false
Chatbot__ApiKey=
